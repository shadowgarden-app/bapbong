# Add files here to ignore them from prettier formatting

# Generated by the package manager, not by anyone here. Prettier reformats it,
# then the next `pnpm install` writes it back its own way — so formatting it is
# a loop, and `nx format:check` fails on main whichever side of the loop the
# committed copy happens to be on.
pnpm-lock.yaml
/dist
/coverage
/.nx/cache
/.nx/workspace-data
.nx/self-healing
.angular
