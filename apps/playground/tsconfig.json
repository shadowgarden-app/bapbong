{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "module": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "paths": {
      "@shadow-garden/bapbong-model": ["../../packages/model/src/index.ts"],
      "@shadow-garden/bapbong-docx": ["../../packages/docx/src/index.ts"],
      "@shadow-garden/bapbong-contracts": ["../../packages/contracts/src/index.ts"],
      "@shadow-garden/bapbong-measuring": ["../../packages/measuring/src/index.ts"],
      "@shadow-garden/bapbong-layout-engine": ["../../packages/layout-engine/src/index.ts"],
      "@shadow-garden/bapbong-painter-canvas": ["../../packages/painter-canvas/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
