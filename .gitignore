# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
vitest.config.*.timestamp*
.angular

# Local-only sample docs for the playground (real-world fixtures may carry
# personal data; the repo goes open-source). Drop your own here for the
# "Load sample" buttons and file-link previews.
apps/playground/public/*.docx

# Compiled MCP shim (bun build --compile; rebuilt by nx build-shim) and its
# staged copy inside the desktop app.
packages/mcp/dist-shim
apps/desktop/shim

# signing credentials (apps/desktop/scripts/release.sh)
.env.release
