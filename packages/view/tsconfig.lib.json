{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../contracts/tsconfig.lib.json" },
    { "path": "../model/tsconfig.lib.json" },
    { "path": "../docx/tsconfig.lib.json" },
    { "path": "../measuring/tsconfig.lib.json" },
    { "path": "../layout-engine/tsconfig.lib.json" },
    { "path": "../painter-canvas/tsconfig.lib.json" },
    { "path": "../selection/tsconfig.lib.json" }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
