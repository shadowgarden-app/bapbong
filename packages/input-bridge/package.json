{
  "name": "@shadow-garden/bapbong-input-bridge",
  "version": "0.4.0",
  "description": "bapbong \u2014 hidden ProseMirror editor as the input/IME sink for the canvas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowgarden-app/bapbong.git",
    "directory": "packages/input-bridge"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@shadow-garden/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "scope:input"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/input-bridge/dist",
          "main": "packages/input-bridge/src/index.ts",
          "tsConfig": "packages/input-bridge/tsconfig.lib.json",
          "format": [
            "esm",
            "cjs"
          ],
          "declarationRootDir": "packages/input-bridge/src"
        }
      }
    }
  },
  "dependencies": {
    "@shadow-garden/bapbong-contracts": "workspace:^",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.7",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.10.0",
    "prosemirror-view": "^1.41.3"
  }
}
