{
  "name": "@shadow-garden/bapbong-editor",
  "version": "0.16.0",
  "description": "bapbong — canvas-rendered DOCX editor for the browser (work in progress)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowgarden-app/bapbong.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@shadow-garden/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "scope:app"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/editor/dist",
          "main": "packages/editor/src/index.ts",
          "tsConfig": "packages/editor/tsconfig.lib.json",
          "format": [
            "esm",
            "cjs"
          ],
          "declarationRootDir": "packages/editor/src",
          "generatePackageJson": false
        }
      }
    }
  },
  "dependencies": {
    "@shadow-garden/bapbong-commands": "workspace:^",
    "@shadow-garden/bapbong-contracts": "workspace:^",
    "@shadow-garden/bapbong-input-bridge": "workspace:^",
    "@shadow-garden/bapbong-model": "workspace:^",
    "@shadow-garden/bapbong-selection": "workspace:^",
    "@shadow-garden/bapbong-view": "workspace:^",
    "prosemirror-model": "^1.25.7",
    "prosemirror-transform": "^1.10.0"
  }
}
