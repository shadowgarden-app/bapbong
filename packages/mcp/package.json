{
  "name": "@shadow-garden/bapbong-mcp",
  "version": "0.6.0",
  "description": "bapbong — MCP server for AI agents: host-agnostic document tools (read/find/edit/format) over a DocumentSession port. Desktop app and headless server mount the same contract.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowgarden-app/bapbong.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@shadow-garden/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./session": {
      "@shadow-garden/source": "./src/session.ts",
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "require": "./dist/session.cjs",
      "default": "./dist/session.js"
    },
    "./host": {
      "@shadow-garden/source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js",
      "require": "./dist/host.cjs",
      "default": "./dist/host.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "scope:headless"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/mcp/dist",
          "main": "packages/mcp/src/index.ts",
          "tsConfig": "packages/mcp/tsconfig.lib.json",
          "format": [
            "esm",
            "cjs"
          ],
          "declarationRootDir": "packages/mcp/src",
          "external": [
            "@shadow-garden/bapbong-headless"
          ],
          "additionalEntryPoints": [
            "packages/mcp/src/session.ts",
            "packages/mcp/src/host.ts"
          ]
        }
      },
      "build-shim": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/tools/shim.mts",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist-shim"
        ],
        "options": {
          "cwd": "packages/mcp",
          "command": "bun build --target=bun --minify tools/shim.mts --outfile dist-shim/shim.js"
        }
      }
    }
  },
  "dependencies": {
    "@shadow-garden/bapbong-headless": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.28",
    "prosemirror-state": "^1.4.4",
    "prosemirror-model": "^1.25.0"
  }
}
