{
  "name": "@shadow-garden/bapbong-mcp",
  "version": "0.0.1",
  "description": "bapbong — MCP server for AI agents: host-agnostic document tools (read/find/edit/format) over a DocumentSession port. Desktop app and headless server mount the same contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@shadow-garden/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": ["scope:headless"],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "packages/mcp/dist",
          "main": "packages/mcp/src/index.ts",
          "tsConfig": "packages/mcp/tsconfig.lib.json",
          "format": ["esm", "cjs"],
          "declarationRootDir": "packages/mcp/src",
          "external": [
            "@shadow-garden/bapbong-headless"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@shadow-garden/bapbong-headless": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.28",
    "prosemirror-state": "^1.4.4",
    "prosemirror-model": "^1.25.0"
  }
}
